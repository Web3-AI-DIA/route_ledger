# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ChangeNOW API
CHANGENOW_API_KEY="your_changenow_api_key_here"
CHANGENOW_WEBHOOK_SECRET="your_changenow_webhook_secret_here"

# Xumm (XRPL)
XUMM_API_KEY="your_xumm_api_key_here"
XUMM_API_SECRET="your_xumm_api_secret_here"

# Reown AppKit (WalletConnect)
NEXT_PUBLIC_REOWN_PROJECT_ID="your_reown_project_id_here"

# Firebase Client SDK
FIREBASE_API_KEY="your_firebase_api_key"
FIREBASE_AUTH_DOMAIN="your_firebase_auth_domain"
FIREBASE_STORAGE_BUCKET="your_firebase_storage_bucket"
FIREBASE_MESSAGING_SENDER_ID="your_firebase_messaging_sender_id"
FIREBASE_APP_ID="your_firebase_app_id"

# Sentry Error Monitoring
SENTRY_DSN="your_sentry_dsn_here"
NEXT_PUBLIC_SENTRY_DSN="your_sentry_dsn_here"

# Firebase Admin SDK (for secure backend updates via webhooks)
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_CLIENT_EMAIL="your_firebase_client_email"
FIREBASE_PRIVATE_KEY="your_firebase_private_key"

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL="your_upstash_redis_rest_url_here"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# Tatum RPC Node
TATUM_API_KEY="your_tatum_api_key_here"

# Chainalysis Compliance
CHAINALYSIS_API_KEY="your_chainalysis_api_key_here"

# Squid Router
SQUID_INTEGRATOR_ID="your_squid_integrator_id_here"
